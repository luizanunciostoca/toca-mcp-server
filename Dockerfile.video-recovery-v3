FROM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json tsconfig.video-recovery.json ./
COPY src ./src
RUN sed -i 's/w=w:h=h/w=iw:h=ih/g' src/the-party-agency-generative-reel-v04-recovery.ts
RUN pnpm exec tsc -p tsconfig.video-recovery.json
RUN pnpm prune --prod

FROM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fontconfig fonts-dejavu-core ca-certificates \
  && rm -rf /var/lib/apt/lists/* /var/cache/apt/*
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
CMD ["node", "dist/src/the-party-agency-generative-reel-v04-recovery.js"]
