NODE_ENV=development
LOG_LEVEL=info

# Local/remote MCP runtime. Keep localhost when using a secure tunnel.
MCP_HOST=127.0.0.1
MCP_PORT=3000

# Provider-backed reads are opt-in and remain side-effect free.
INSTAGRAM_READ_ENABLED=false
META_ADS_READ_ENABLED=false
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN_ENV_KEY=

# Meta Ads writes are fail-closed, opt-in and limited to CREATE_PAUSED.
META_ADS_WRITE_ENABLED=false
META_ADS_ALLOWED_ACCOUNT_ID=
META_ADS_ALLOWED_CURRENCY=
META_ADS_MAX_DAILY_BUDGET_MINOR=
META_ADS_ALLOWED_GEO_KEYS=
META_ADS_ALLOWED_PIXEL_ID=
META_ADS_ALLOWED_PAGE_ID=
META_ADS_ALLOWED_INSTAGRAM_ACTOR_ID=
META_ADS_APPROVED_REQUEST_SHA256=

# Meta stays disabled until the real app/account validation step.
META_ENABLED=false

# Non-secret identifiers/endpoints. Do not commit real secret values.
META_APP_ID=
META_APP_SECRET_PROVIDER=
META_APP_SECRET_KEY=
META_AUTHORIZATION_ENDPOINT=https://www.facebook.com/dialog/oauth
META_TOKEN_ENDPOINT=https://graph.facebook.com/oauth/access_token
META_REDIRECT_URI=
META_REQUESTED_SCOPES=
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=
