NODE_ENV=development
LOG_LEVEL=info
MCP_ENABLED=true
DATABASE_URL=
DATABASE_SSL=false

# Local/remote MCP runtime. Keep localhost when using a secure tunnel.
MCP_HOST=127.0.0.1
MCP_PORT=3000

# Next release identity and canonical tenant scope. Production readiness requires
# all of these to be explicit; development/test may leave them unset.
TOCA_DEPLOY_ENVIRONMENT=
TOCA_RELEASE_SHA=
TOCA_DEFAULT_TENANT_ID=
TOCA_DEFAULT_WORKSPACE_ID=
TOCA_DEFAULT_ORGANIZATION_ID=
TOCA_READY_OUTBOX_MAX_LAG_SECONDS=300

# Provider verification flags are release evidence gates, not convenience flags.
# Never set one to true until the corresponding provider validation/readback is
# canonically recorded. Deployment and /readyz both fail closed when an enabled
# provider is not verified.
META_PROVIDER_VERIFIED=false
WHATSAPP_PROVIDER_VERIFIED=false
EMAIL_SENDGRID_PROVIDER_VERIFIED=false
GOOGLE_ADS_PROVIDER_VERIFIED=false
AG01_MODEL_PROVIDER_VERIFIED=false

# Provider-backed reads are opt-in and remain side-effect free.
INSTAGRAM_READ_ENABLED=false
META_ADS_READ_ENABLED=false
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN_ENV_KEY=

# Meta Ads writes are fail-closed, opt-in and limited by existing capability
# contracts. Do not enable merely for a deploy/readiness test.
META_ADS_WRITE_ENABLED=false
META_ADS_ALLOWED_ACCOUNT_ID=
META_ADS_ALLOWED_CURRENCY=
META_ADS_MAX_DAILY_BUDGET_MINOR=
META_ADS_ALLOWED_GEO_KEYS=
META_ADS_ALLOWED_PIXEL_ID=
META_ADS_ALLOWED_PAGE_ID=
META_ADS_ALLOWED_INSTAGRAM_ACTOR_ID=
META_ADS_APPROVED_REQUEST_SHA256=

# Meta stays disabled until provider evidence exists.
META_ENABLED=false
META_WEBHOOK_ENABLED=false
META_WEBHOOK_PERSISTENCE_ENABLED=false
META_APP_ID=
META_APP_SECRET_PROVIDER=
META_APP_SECRET_KEY=
META_WEBHOOK_VERIFY_TOKEN_KEY=
META_AUTHORIZATION_ENDPOINT=https://www.facebook.com/dialog/oauth
META_TOKEN_ENDPOINT=https://graph.facebook.com/oauth/access_token
META_REDIRECT_URI=
META_REQUESTED_SCOPES=
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v24.0
META_TOKEN_STORE_PROVIDER=memory
META_TOKEN_SECRET_ID=
GCP_PROJECT_ID=

# WhatsApp Cloud API readiness contract only. Business/runtime logic remains
# owned by the WhatsApp workstream. Keep disabled until PROVIDER_VERIFIED and
# binding state PRODUCTION_VALIDATED are both proven.
WHATSAPP_ENABLED=false
WHATSAPP_BINDING_ID=
WHATSAPP_BINDING_STATE=UNBOUND
WHATSAPP_META_APP_ID=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN_ENV_KEY=

# Real Email / Twilio SendGrid remains fail-closed until sender/domain, SPF,
# DKIM, DMARC, webhook signatures, credentials and provider readback are
# externally validated. Never put the API key itself in this file.
EMAIL_SENDGRID_ENABLED=false
EMAIL_SENDGRID_BINDING_ID=
EMAIL_SENDGRID_BINDING_STATE=UNBOUND
EMAIL_SENDGRID_API_BASE_URL=https://api.sendgrid.com
EMAIL_SENDGRID_API_KEY_SECRET_PROVIDER=env
EMAIL_SENDGRID_API_KEY_SECRET_KEY=SENDGRID_API_KEY
EMAIL_SENDGRID_SENDING_DOMAIN=
EMAIL_SENDGRID_FROM_EMAIL=
EMAIL_SENDGRID_FROM_NAME=
EMAIL_SENDGRID_REPLY_TO_EMAIL=
EMAIL_SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY_PEM=
EMAIL_SENDGRID_INBOUND_PARSE_ENABLED=false
EMAIL_SENDGRID_INBOUND_PARSE_HOSTNAME=
EMAIL_SENDGRID_INBOUND_PARSE_PUBLIC_KEY_PEM=
EMAIL_SENDGRID_EMAIL_ACTIVITY_READBACK_ENABLED=false
# Optional DNS evidence inputs used by production validation. JSON array of
# {"host":"s1._domainkey.example.com","target":"..."} entries.
EMAIL_SENDGRID_DKIM_RECORDS_JSON=[]
EMAIL_SENDGRID_SPF_INCLUDE=sendgrid.net

# Google Ads remains OFF unless provider credentials/customer/billing are
# PROVIDER_VERIFIED. Activation is a separate explicit capability gate.
GOOGLE_ADS_PHASE=OFF
GOOGLE_ADS_ACTIVATE_ENABLED=false
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_ALLOWED_CUSTOMER_ID=
GOOGLE_ADS_ALLOWED_CURRENCY=
GOOGLE_ADS_MAX_DAILY_BUDGET_MICROS=
GOOGLE_ADS_CURRENCY_MINOR_UNIT_MICROS=
GOOGLE_ADS_ALLOWED_LOCATION_CRITERION_IDS=
GOOGLE_ADS_ALLOWED_LANGUAGE_CRITERION_IDS=
GOOGLE_ADS_DEVELOPER_TOKEN_ENV_KEY=
GOOGLE_ADS_ACCESS_TOKEN_ENV_KEY=
GOOGLE_ADS_OAUTH_CLIENT_ID_ENV_KEY=
GOOGLE_ADS_OAUTH_CLIENT_SECRET_ENV_KEY=
GOOGLE_ADS_OAUTH_REFRESH_TOKEN_ENV_KEY=
GOOGLE_ADS_OAUTH_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token

# AG-01 model-provider credentials are separate from the orchestration runtime.
# The model provider remains disabled until its own provider verification exists.
AG01_MODEL_ENABLED=false
AG01_MODEL_PROVIDER=
AG01_MODEL_NAME=
AG01_MODEL_API_KEY_ENV_KEY=
