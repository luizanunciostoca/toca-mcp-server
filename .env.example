NODE_ENV=development
LOG_LEVEL=info
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ENABLED=true
DATABASE_URL=
DATABASE_SSL=false

# Deployment identity/configuration. Production injects DATABASE_URL and provider
# credentials from GCP Secret Manager into runtime env references; secret values
# never belong in this file, logs, or artifacts.
TOCA_SERVICE_ROLE=mcp
TOCA_DEPLOY_ENVIRONMENT=
TOCA_RELEASE_SHA=
TOCA_PLATFORM_KILL_SWITCH=false
TOCA_DEFAULT_TENANT_ID=
TOCA_DEFAULT_WORKSPACE_ID=
TOCA_DEFAULT_ORGANIZATION_ID=
TOCA_READY_OUTBOX_MAX_LAG_SECONDS=300

# Autonomy control plane. External side effects remain denied until the readiness
# JSON contains every canonical check as PASS with evidence and provider health
# contains a matching tenant/provider entry with HEALTHY + CLOSED circuit.
TOCA_AUTONOMY_MODE=SUPERVISED_AUTO
TOCA_AUTOPILOT_POLICY_VERSION=1.1.0
TOCA_AUTOPILOT_READINESS_JSON={}
TOCA_PROVIDER_HEALTH_JSON=[]
TOCA_TENANT_KILL_SWITCHES=
TOCA_PROVIDER_KILL_SWITCHES=
TOCA_CAPABILITY_KILL_SWITCHES=

# Meta / Instagram default fail-closed.
META_ENABLED=false
META_PROVIDER_VERIFIED=false
META_WEBHOOK_ENABLED=false
META_WEBHOOK_PERSISTENCE_ENABLED=false
INSTAGRAM_READ_ENABLED=false
INSTAGRAM_ENGAGEMENT_WRITES_ENABLED=false
INSTAGRAM_PUBLICATION_WRITES_ENABLED=false
META_ADS_READ_ENABLED=false
META_ADS_WRITE_ENABLED=false
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN_ENV_KEY=
META_APP_ID=
META_APP_SECRET_PROVIDER=env
META_APP_SECRET_KEY=
META_WEBHOOK_VERIFY_TOKEN_KEY=
META_AUTHORIZATION_ENDPOINT=https://www.facebook.com/dialog/oauth
META_TOKEN_ENDPOINT=https://graph.facebook.com/oauth/access_token
META_REDIRECT_URI=
META_REQUESTED_SCOPES=
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v24.0
META_ADS_ALLOWED_ACCOUNT_ID=
META_ADS_ALLOWED_CURRENCY=
META_ADS_MAX_DAILY_BUDGET_MINOR=
META_ADS_ALLOWED_GEO_KEYS=
META_ADS_ALLOWED_PIXEL_ID=
META_ADS_ALLOWED_PAGE_ID=
META_ADS_ALLOWED_INSTAGRAM_ACTOR_ID=
META_ADS_APPROVED_REQUEST_SHA256=

# Instagram engagement runtime. The worker may run read/classify-only while
# INSTAGRAM_ENGAGEMENT_WRITES_ENABLED=false. Enabling the runtime only activates
# durable webhook -> outbox -> policy/CRM processing; it does not by itself
# authorize external replies.
INSTAGRAM_ENGAGEMENT_RUNTIME_ENABLED=false
INSTAGRAM_ENGAGEMENT_TENANT_ID=
INSTAGRAM_ENGAGEMENT_WORKSPACE_ID=
INSTAGRAM_ENGAGEMENT_ORGANIZATION_ID=
INSTAGRAM_ENGAGEMENT_PAGE_ID=
INSTAGRAM_ENGAGEMENT_KNOWLEDGE_SPREADSHEET_ID=
INSTAGRAM_ENGAGEMENT_KNOWLEDGE_RANGE=FAQ_IA!A:T
# google-sheets = direct FAQ reads. postgres = canonical FAQ mirror and optional
# tiered Knowledge Base. Production should use postgres after governed sync.
INSTAGRAM_ENGAGEMENT_KNOWLEDGE_SOURCE=google-sheets
# Tiered resolution is FAQ first, then the sanitized TOCA OS Knowledge Base.
# Keep OFF until migration 037 and the canonical source sync pass readiness.
INSTAGRAM_ENGAGEMENT_KNOWLEDGE_BASE_ENABLED=false
INSTAGRAM_ENGAGEMENT_KB_MIN_CONFIDENCE=0.58
INSTAGRAM_ENGAGEMENT_KB_CANDIDATE_LIMIT=12
INSTAGRAM_ENGAGEMENT_KB_SOURCE_IDS=SRC-OPS-001,SRC-MENU-002,SRC-LOC-001
# Production should use gcp-iam. env remains available for local/test only.
INSTAGRAM_ENGAGEMENT_GOOGLE_SHEETS_AUTH_MODE=env
INSTAGRAM_ENGAGEMENT_GOOGLE_SERVICE_ACCOUNT_EMAIL=
INSTAGRAM_ENGAGEMENT_GOOGLE_SHEETS_TOKEN_ENV_KEY=
INSTAGRAM_ENGAGEMENT_KNOWLEDGE_CACHE_MS=60000
INSTAGRAM_ENGAGEMENT_BATCH_SIZE=10
INSTAGRAM_ENGAGEMENT_POLL_MS=1000
INSTAGRAM_ENGAGEMENT_STALE_CLAIM_MS=300000
INSTAGRAM_ENGAGEMENT_SUNSET_SERIES_KEY=sunset
INSTAGRAM_ENGAGEMENT_THE_PARTY_SERIES_KEY=the-party

# WhatsApp runtime is disabled until canonical binding and provider evidence exist.
WHATSAPP_ENABLED=false
WHATSAPP_RUNTIME_ENABLED=false
WHATSAPP_PROVIDER_VERIFIED=false
WHATSAPP_BINDING_ID=
WHATSAPP_BINDING_STATE=UNBOUND
WHATSAPP_META_APP_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN_ENV_KEY=

# Twilio SendGrid. In GCP the control plane reads Secret Manager and injects the
# selected secret version as an env-backed runtime reference. This intentionally
# uses provider=env at runtime; the plaintext key is never committed here.
EMAIL_SENDGRID_ENABLED=false
EMAIL_SENDGRID_PROVIDER_VERIFIED=false
EMAIL_SENDGRID_BINDING_ID=
EMAIL_SENDGRID_BINDING_STATE=UNBOUND
EMAIL_SENDGRID_API_BASE_URL=https://api.sendgrid.com
EMAIL_SENDGRID_API_KEY_SECRET_PROVIDER=env
EMAIL_SENDGRID_API_KEY_SECRET_KEY=
EMAIL_SENDGRID_SENDING_DOMAIN=
EMAIL_SENDGRID_FROM_EMAIL=
EMAIL_SENDGRID_FROM_NAME=
EMAIL_SENDGRID_REPLY_TO_EMAIL=
# Optional selector for signed Event Webhook autodiscovery. When omitted,
# discovery requires exactly one enabled signed webhook and otherwise fails closed.
EMAIL_SENDGRID_EVENT_WEBHOOK_URL=
EMAIL_SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY_PEM=
EMAIL_SENDGRID_INBOUND_PARSE_ENABLED=false
EMAIL_SENDGRID_INBOUND_PARSE_HOSTNAME=
EMAIL_SENDGRID_INBOUND_PARSE_PUBLIC_KEY_PEM=
EMAIL_SENDGRID_EMAIL_ACTIVITY_READBACK_ENABLED=false
EMAIL_SENDGRID_DKIM_RECORDS_JSON=[]
EMAIL_SENDGRID_SPF_INCLUDE=sendgrid.net

# Google Ads defaults OFF/unverified.
GOOGLE_ADS_PHASE=OFF
GOOGLE_ADS_PROVIDER_VERIFIED=false
GOOGLE_ADS_ACTIVATE_ENABLED=false
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_ACCESS_TOKEN_ENV_KEY=
GOOGLE_ADS_OAUTH_CLIENT_ID_ENV_KEY=
GOOGLE_ADS_OAUTH_CLIENT_SECRET_ENV_KEY=
GOOGLE_ADS_OAUTH_REFRESH_TOKEN_ENV_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN_ENV_KEY=
GOOGLE_ADS_ALLOWED_CUSTOMER_ID=
GOOGLE_ADS_ALLOWED_CURRENCY=
GOOGLE_ADS_MAX_DAILY_BUDGET_MICROS=
GOOGLE_ADS_CURRENCY_MINOR_UNIT_MICROS=
GOOGLE_ADS_ALLOWED_LOCATION_CRITERION_IDS=
GOOGLE_ADS_ALLOWED_LANGUAGE_CRITERION_IDS=

# AG-01 model provider defaults disabled/unverified.
AG01_MODEL_ENABLED=false
AG01_MODEL_PROVIDER_VERIFIED=false
AG01_MODEL_PROVIDER=
AG01_MODEL_NAME=
AG01_MODEL_API_KEY_ENV_KEY=

# Governed image-to-video scene-continuation runtime. The MCP surface remains
# fail-closed unless OpenAI + Google + GCS bindings are complete. Prefer renewable
# Google OAuth in long-running runtimes; short-lived token refs remain available
# for controlled local/provider smokes.
OPENAI_VIDEO_MODEL=sora-2
OPENAI_API_KEY_ENV_KEY=
GOOGLE_SHEETS_ACCESS_TOKEN_ENV_KEY=
GOOGLE_DRIVE_ACCESS_TOKEN_ENV_KEY=
VIDEO_GOOGLE_OAUTH_CLIENT_ID_ENV_KEY=
VIDEO_GOOGLE_OAUTH_CLIENT_SECRET_ENV_KEY=
VIDEO_GOOGLE_OAUTH_REFRESH_TOKEN_ENV_KEY=
VIDEO_GOOGLE_OAUTH_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
INSTAGRAM_PUBLICATION_ASSET_BUCKET=
