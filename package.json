{
  "name": "toca-mcp-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "dev:instagram-publication-worker": "tsx src/instagram-publication-worker.ts",
    "dev:instagram-publication-readiness": "tsx src/instagram-publication-readiness-preflight.ts",
    "dev:instagram-controlled-publication": "tsx src/instagram-controlled-publication.ts",
    "dev:instagram-publication-approval-manifest": "tsx src/instagram-publication-approval-manifest.ts",
    "dev:instagram-publication-asset-staging": "tsx src/instagram-publication-asset-staging.ts",
    "dev:marketing-autopilot-image-edit": "tsx src/marketing-autopilot-image-edit.ts",
    "dev:marketing-autopilot-image-generate": "tsx src/marketing-autopilot-image-generate.ts",
    "dev:marketing-autopilot-the-party-context": "tsx src/marketing-autopilot-the-party-context.ts",
    "dev:marketing-autopilot-the-party-writeback": "tsx src/marketing-autopilot-the-party-writeback.ts",
    "start": "node dist/src/index.js",
    "start:http": "node dist/src/http.js",
    "start:instagram-publication-worker": "node dist/src/instagram-publication-worker.js",
    "start:instagram-publication-readiness": "node dist/src/instagram-publication-readiness-preflight.js",
    "start:instagram-controlled-publication": "node dist/src/instagram-controlled-publication.js",
    "start:instagram-publication-approval-manifest": "node dist/src/instagram-publication-approval-manifest.js",
    "start:instagram-publication-asset-staging": "node dist/src/instagram-publication-asset-staging.js",
    "start:marketing-autopilot-image-edit": "node dist/src/marketing-autopilot-image-edit.js",
    "start:marketing-autopilot-image-generate": "node dist/src/marketing-autopilot-image-generate.js",
    "start:marketing-autopilot-the-party-context": "node dist/src/marketing-autopilot-the-party-context.js",
    "start:marketing-autopilot-the-party-writeback": "node dist/src/marketing-autopilot-the-party-writeback.js",
    "migrate": "tsx scripts/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture:check": "node scripts/architecture-check.mjs && node scripts/infrastructure-control-plane-check.mjs && node scripts/check-creative-truth-contract.mjs && node scripts/check-creative-truth-brand-integrity-contract.mjs && node scripts/check-creative-truth-generative-contract.mjs && node scripts/check-operation-scoped-generative-truth.mjs && node scripts/check-the-party-creative-standard.mjs && node scripts/check-the-party-content-context-contract.mjs && node scripts/check-the-party-writeback-contract.mjs",
    "quality": "pnpm format:check && pnpm architecture:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "pg": "^8.16.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
