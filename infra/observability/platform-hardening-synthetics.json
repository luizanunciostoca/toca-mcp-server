{
  "schemaVersion": 2,
  "checkSetId": "toca-platform-hardening-next",
  "safety": {
    "realSideEffectsForTesting": false,
    "destructiveOperations": false,
    "providerMutationAllowed": false,
    "controlPlaneNotificationDeliveryAllowed": true
  },
  "checks": [
    {
      "id": "runtime-readiness",
      "mode": "READ_ONLY",
      "assertion": "authenticated /healthz returns process liveness and /readyz returns 200 only when every mandatory dependency is ready",
      "frequencyMinutes": 5
    },
    {
      "id": "candidate-readiness-before-traffic",
      "mode": "READ_ONLY",
      "assertion": "tagged Cloud Run candidate passes authenticated /healthz and /readyz before any traffic promotion",
      "frequencyMinutes": 0
    },
    {
      "id": "audit-integrity",
      "mode": "INTERNAL_CONTRACT",
      "assertion": "audit ledger verification remains valid",
      "frequencyMinutes": 15
    },
    {
      "id": "outbox-lag",
      "mode": "INTERNAL_CONTRACT",
      "assertion": "oldest pending Outbox age remains within SLO and dead-letter state is incident-classified",
      "frequencyMinutes": 5
    },
    {
      "id": "dead-letter-backlog",
      "mode": "INTERNAL_CONTRACT",
      "assertion": "dead-letter backlog remains zero or incident-classified",
      "frequencyMinutes": 5
    },
    {
      "id": "provider-readback-contract",
      "mode": "READ_ONLY",
      "assertion": "verified provider reads/readbacks remain available without creating a mutation",
      "frequencyMinutes": 15
    },
    {
      "id": "crm-read-contract",
      "mode": "READ_ONLY",
      "assertion": "CRM durable records are readable through the governed core",
      "frequencyMinutes": 15
    },
    {
      "id": "attribution-read-contract",
      "mode": "READ_ONLY",
      "assertion": "attribution durable records are readable through the governed core",
      "frequencyMinutes": 15
    },
    {
      "id": "alert-firing-delivery-readback",
      "mode": "CONTROL_PLANE",
      "assertion": "controlled synthetic signal opens the intended Cloud Monitoring incident, delivers through configured real notification channels, is independently read back, and temporary proof resources are cleaned up",
      "frequencyMinutes": 0,
      "activationGate": "RELEASE_VALIDATION",
      "reuseVerifiedBaselineEvidence": "docs/operations/alerts-production-verification-2026-08-16.md"
    }
  ],
  "futureChecks": [
    {
      "id": "whatsapp-provider-read",
      "enabled": false,
      "activationGate": "PROVIDER_VERIFIED"
    },
    {
      "id": "email-provider-read",
      "enabled": false,
      "activationGate": "PROVIDER_VERIFIED"
    },
    {
      "id": "google-ads-provider-read",
      "enabled": false,
      "activationGate": "PROVIDER_VERIFIED"
    },
    {
      "id": "r31-feedback-readback",
      "enabled": false,
      "activationGate": "R31_IMPLEMENTED"
    }
  ],
  "runbook": "docs/operations/observability-incident-runbook.md"
}
