{
  "schemaVersion": 2,
  "policySetId": "toca-platform-hardening-next",
  "policies": [
    {
      "id": "http-error-rate",
      "signal": "http.request_error_ratio",
      "operator": ">",
      "threshold": 0.01,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "http-latency",
      "signal": "http.request_p95_seconds",
      "operator": ">",
      "threshold": 2,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "provider-readback-unverified",
      "signal": "provider.readback_verified_ratio",
      "operator": "<",
      "threshold": 1,
      "windowMinutes": 15,
      "severity": "P0"
    },
    {
      "id": "provider-errors",
      "signal": "provider.error_count",
      "operator": ">",
      "threshold": 0,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "publication-slo",
      "signal": "publication.verified_terminal_success_ratio",
      "operator": "<",
      "threshold": 0.995,
      "windowMinutes": 60,
      "severity": "P1"
    },
    {
      "id": "workflow-slo",
      "signal": "workflow.terminal_success_ratio",
      "operator": "<",
      "threshold": 0.995,
      "windowMinutes": 60,
      "severity": "P1"
    },
    {
      "id": "lead-ingestion-slo",
      "signal": "lead.ingestion_success_ratio",
      "operator": "<",
      "threshold": 0.995,
      "windowMinutes": 60,
      "severity": "P1"
    },
    {
      "id": "first-response-latency",
      "signal": "lead.first_response_p95_seconds",
      "operator": ">",
      "threshold": 300,
      "windowMinutes": 60,
      "severity": "P1"
    },
    {
      "id": "webhook-slo",
      "signal": "webhook.accepted_success_ratio",
      "operator": "<",
      "threshold": 0.999,
      "windowMinutes": 60,
      "severity": "P1"
    },
    {
      "id": "webhook-failures",
      "signal": "webhook.failure_count",
      "operator": ">",
      "threshold": 0,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "outbox-lag",
      "signal": "outbox.oldest_pending_age_seconds",
      "operator": ">",
      "threshold": 300,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "retry-exhausted",
      "signal": "retry.exhausted_count",
      "operator": ">",
      "threshold": 0,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "dead-letter-backlog",
      "signal": "dead_letter.pending_count",
      "operator": ">",
      "threshold": 0,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "queue-backlog",
      "signal": "queue.backlog_count",
      "operator": ">",
      "threshold": 100,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "ag01-failures",
      "signal": "ag01.failure_count",
      "operator": ">",
      "threshold": 0,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "approval-latency",
      "signal": "approval.decision_p95_seconds",
      "operator": ">",
      "threshold": 900,
      "windowMinutes": 60,
      "severity": "P1"
    },
    {
      "id": "crm-write-slo",
      "signal": "crm.durable_write_success_ratio",
      "operator": "<",
      "threshold": 0.999,
      "windowMinutes": 60,
      "severity": "P1"
    },
    {
      "id": "crm-errors",
      "signal": "crm.error_count",
      "operator": ">",
      "threshold": 0,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "attribution-write-slo",
      "signal": "attribution.durable_write_success_ratio",
      "operator": "<",
      "threshold": 0.999,
      "windowMinutes": 60,
      "severity": "P1"
    },
    {
      "id": "revenue-attribution-errors",
      "signal": "revenue_attribution.error_count",
      "operator": ">",
      "threshold": 0,
      "windowMinutes": 15,
      "severity": "P1"
    },
    {
      "id": "r31-feedback-loop",
      "signal": "r31.feedback_loop_success_ratio",
      "operator": "<",
      "threshold": 0.99,
      "windowMinutes": 1440,
      "severity": "P2"
    }
  ],
  "futureProviderPolicies": [
    {
      "id": "whatsapp-delivery-slo",
      "signal": "whatsapp.delivery_verified_ratio",
      "operator": "<",
      "threshold": 0.99,
      "windowMinutes": 60,
      "severity": "P1",
      "enabled": false
    },
    {
      "id": "email-delivery-slo",
      "signal": "email.delivery_verified_ratio",
      "operator": "<",
      "threshold": 0.99,
      "windowMinutes": 60,
      "severity": "P1",
      "enabled": false
    }
  ],
  "routing": {
    "minimumNotificationChannels": 2,
    "requireRedundantChannelFamilies": true,
    "escalation": {
      "P0Minutes": 5,
      "P1Minutes": 15,
      "P2Minutes": 60
    },
    "syntheticFiringRequiresReadback": true
  },
  "mandatoryExistingPolicies": ["AUDIT_LEDGER_INTEGRITY_FAILED", "OUTBOX_DELIVERY_STALLED"],
  "runbook": "docs/operations/observability-incident-runbook.md",
  "notes": "Declarative alert contract. Unverified providers stay disabled; managed-provider firing, delivery and readback are required release evidence."
}
