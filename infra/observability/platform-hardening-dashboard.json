{
  "schemaVersion": 2,
  "dashboardId": "toca-platform-hardening-next",
  "routeIds": ["R25", "R31"],
  "title": "TOCA OS Platform Hardening — Next Version",
  "panels": [
    {
      "id": "http-runtime",
      "signals": ["http.request_rate", "http.request_error_ratio", "http.request_p95_seconds"],
      "sourcePlane": "cloud_run_native"
    },
    {
      "id": "publication",
      "signals": ["publication.verified_terminal_success_ratio"]
    },
    {
      "id": "workflow",
      "signals": ["workflow.terminal_success_ratio"]
    },
    {
      "id": "provider-readback",
      "signals": ["provider.readback_verified_ratio", "provider.error_count"]
    },
    {
      "id": "lead-ingestion",
      "signals": ["lead.ingestion_success_ratio", "lead.first_response_p95_seconds"]
    },
    {
      "id": "webhook",
      "signals": ["webhook.accepted_success_ratio", "webhook.failure_count"]
    },
    {
      "id": "outbox-retry-dead-letter",
      "signals": [
        "outbox.oldest_pending_age_seconds",
        "retry.exhausted_count",
        "dead_letter.pending_count",
        "queue.backlog_count"
      ]
    },
    {
      "id": "ag01",
      "signals": ["ag01.failure_count"]
    },
    {
      "id": "approval",
      "signals": ["approval.decision_p95_seconds"]
    },
    {
      "id": "crm-attribution",
      "signals": [
        "crm.durable_write_success_ratio",
        "crm.error_count",
        "attribution.durable_write_success_ratio",
        "revenue_attribution.error_count"
      ]
    },
    {
      "id": "future-provider-readiness",
      "signals": ["whatsapp.delivery_verified_ratio", "email.delivery_verified_ratio"],
      "inactiveUntilProviderVerified": true
    },
    {
      "id": "r31",
      "signals": ["r31.feedback_loop_success_ratio"]
    }
  ],
  "requiredDimensions": [
    "environment",
    "revision",
    "correlation_id",
    "execution_id",
    "tenant_id",
    "route_id",
    "provider",
    "status"
  ],
  "sourcePlanes": ["cloud_run_native", "operational_signals"],
  "notes": "Cloud Run native request metrics cover rate/error/latency; canonical application signals remain in operational_signals. Provider-specific panels stay inactive until provider verification."
}
