  "region": "southamerica-east1",
  "operator": {
    "serviceAccount": "toca-next-stg-deployer@toca-mcp-next-staging.iam.gserviceaccount.com",
    "workloadIdentityProvider": "projects/729069789107/locations/global/workloadIdentityPools/github-staging/providers/github-toca-mcp-staging"
  },
  "iamBootstrap": {
    "enabled": true,
    "projectId": "toca-mcp-next-staging",
    "projectNumber": "729069789107",
    "principal": "serviceAccount:toca-next-stg-deployer@toca-mcp-next-staging.iam.gserviceaccount.com",
    "role": "roles/monitoring.notificationChannelEditor",
    "condition": "None",
    "purpose": "staging Reliability notification channels only"
  },
  "channels": [
    {
      "role": "primary-email",
      "type": "email",
      "destinationSecret": "STAGING_ALERT_EMAIL",
      "enabled": true
    },
    {
      "role": "secondary-webhook",
      "type": "webhook_tokenauth",
      "destinationSecret": "STAGING_ALERT_WEBHOOK_URL",
      "tokenSecret": "STAGING_ALERT_WEBHOOK_TOKEN",
      "enabled": true
    }
  ],
  "requirements": {
    "minimumEnabledChannels": 2,
    "minimumChannelFamilies": 2,
    "requireHttpsWebhook": true,
    "requireEmailVerification": true,
    "sendEmailVerificationCodeWhenRequired": true,
    "requireSyntheticDeliveryReadbackBeforeReliabilityPromotion": true
