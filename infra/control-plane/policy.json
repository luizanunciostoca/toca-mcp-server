{
  "version": 5,
  "projectId": "toca-mcp-production",
  "region": "southamerica-east1",
  "adminServiceAccount": "toca-mcp-infra-admin@toca-mcp-production.iam.gserviceaccount.com",
  "runtimeServiceAccount": "toca-mcp-runtime@toca-mcp-production.iam.gserviceaccount.com",
  "allowedOperations": {
    "reconcile-publication-assets-bucket": {
      "resourceType": "gcs-bucket",
      "resourceName": "toca-mcp-publication-assets",
      "publicRead": false,
      "deliveryMode": "signed-url",
      "runtimeRoles": ["roles/storage.objectCreator", "roles/storage.objectViewer"],
      "lifecycleDeleteAgeDays": 7,
      "uniformBucketLevelAccess": true
    }
  },
  "activeRuntime": {
    "tocaManagedInstagramScheduler": {
      "resourceType": "cloud-run-service",
      "resourceName": "toca-managed-instagram-daemon",
      "runtimeServiceAccount": "toca-mcp-runtime@toca-mcp-production.iam.gserviceaccount.com",
      "private": true,
      "minInstances": 1,
      "maxInstances": 1,
      "concurrency": 1,
      "pollIntervalMs": 60000,
      "schedulerBackend": "postgresql",
      "scheduleTransport": "protected-mcp",
      "contentPayloadInInfrastructureTimer": false,
      "legacyHeartbeatSuperseded": true
    }
  },
  "forbidden": {
    "projectOwner": true,
    "projectEditor": true,
    "serviceAccountKeys": true,
    "bucketDelete": true,
    "arbitraryGcloud": true,
    "runtimePrivilegeEscalation": true,
    "publicBucketIam": true,
    "perContentSchedulerJobs": true,
    "legacyHeartbeatRecreation": true,
    "deployAsSchedulingTransport": true
  }
}
