      "postGenerationReviewRequired": true
    },
    "GENERATIVE_SCENE_CONTINUATION_VIDEO": {
      "enabled": true,
      "sourceImageRequired": true,
      "marketingReadyMasterRequired": true,
      "rightsEvidenceRequired": true,
      "explicitApprovalRequired": true,
      "sourceImageShaBindingRequired": true,
      "likenessConsentRequiredWhenPeoplePresent": true,
      "architecturalInventionAllowed": false,
      "environmentDriftAllowed": false,
      "aiLogoGenerationAllowed": false,
      "provider": "OPENAI_VIDEO_API",
