{
  "schemaVersion": "1.4",
  "policyId": "TOCA_PHOTO_TO_VIDEO_POLICY_V1",
  "policyVersion": "1.4",
  "status": "ACTIVE_CANONICAL",
  "parentPolicyId": "TOCA_CREATIVE_TRUTH_POLICY_V1",
  "brandScope": "TOCA_DO_MORCEGO",
  "routes": {
    "REAL_PHOTO_TO_MOTION_VIDEO": {
      "enabled": true,
      "sourceImageRequired": true,
      "marketingReadyMasterRequired": true,
      "rightsEvidenceRequired": true,
      "sceneExpansionAllowed": false,
      "architecturalInventionAllowed": false,
      "aiLogoGenerationAllowed": false,
      "provider": "LOCAL_FFMPEG",
      "postGenerationReviewRequired": true
    },
    "GENERATIVE_SCENE_CONTINUATION_VIDEO": {
      "enabled": true,
      "sourceImageRequired": true,
      "marketingReadyMasterRequired": true,
      "rightsEvidenceRequired": true,
      "explicitApprovalRequired": true,
      "sourceImageShaBindingRequired": true,
      "likenessConsentRequiredWhenPeoplePresent": true,
      "architecturalInventionAllowed": false,
      "environmentDriftAllowed": false,
      "aiLogoGenerationAllowed": false,
      "provider": "GOOGLE_VERTEX_VEO",
      "providerStrategy": "ORDERED_FAILOVER",
      "primaryProvider": "GOOGLE_VERTEX_VEO",
      "fallbackProviders": ["OPENAI_VIDEO_API"],
      "fallbackOnlyOnRetryableProviderFailure": true,
      "fallbackForbiddenForPolicyApprovalRightsBindingFidelityOrSpecFailures": true,
      "providerAttemptChainEvidenceRequired": true,
      "allowedModelsByProvider": {
        "GOOGLE_VERTEX_VEO": ["veo-3.1-generate-001", "veo-3.1-fast-generate-001"],
        "OPENAI_VIDEO_API": ["sora-2", "sora-2-pro"]
      },
      "runtimeAuthMode": "GCP_SERVICE_IDENTITY",
      "providerLocation": "us-central1",
      "postGenerationHumanReviewRequired": true,
      "sceneContinuationFidelityGateRequired": true
    }
  },
  "rightsReadiness": {
    "activeRecordRequired": true,
    "durableEvidenceRefRequired": true,
    "validatedAtRequired": true,
    "routeSpecificApprovedUseRequired": true,
    "likenessConfirmedForGenerativePeople": true,
    "validityWindowEnforcedWhenPresent": true,
    "revocationAlwaysFailClosed": true,
    "noInferenceFromDriveFolderPriorPublicationOrMarketingReady": true
  },
  "sourceLibrary": {
    "canonicalRegistry": "CREATIVE_TRUTH_REGISTRY.VIDEO_SHOTS",
    "sourceDriveFileIdRequired": true,
    "sourceSha256RequiredBeforeAutomaticUse": true,
    "venueVerifiedRequired": true,
    "rightsEligibilityRequired": true,
    "storyFunctionMetadataRecommended": true,
    "usageAndAntiRepeatMetadataRecommended": true
  },
  "reviewBoundary": {
    "durableCandidateArtifactRequired": true,
    "candidateArtifactSha256Required": true,
    "artifactReadbackRequiredBeforeFinalization": true,
    "canonicalSourceDriveBytesRevalidatedAtFinalization": true,
    "officialHeroBrandDriveBytesRevalidatedAtFinalization": true,
    "heroBrandAssetIdDriveIdAndShaBoundInCandidate": true,
    "thePartyEditionIntentEnvironmentBoundInCandidate": true,
    "reviewTimestampMustFollowCandidateAndNotExceedTrustedFinalizationTime": true,
    "sourceImageComparedRequired": true,
    "durableEvidenceRefRequired": true,
    "architectureDriftMustBeFalse": true,
    "environmentDriftMustBeFalse": true,
    "aiLogoReconstructionDetectedMustBeFalse": true
  },
  "publicationBoundary": {
    "exactFinalAssetSha256Required": true,
    "durableFinalArtifactRefRequired": true,
    "publicationMayNotRebuildCreative": true,
    "prepareMayNotRebuildCreative": true,
    "publicationAuthorizedByGeneration": false,
    "publicationAuthorizedByFinalization": false
  },
  "fullSyntheticVenueVideoWithoutSourceImage": "UNSUPPORTED_V1",
  "futureProductOnboarding": "REGISTRY_DRIVEN_NO_RUNTIME_CODE_CHANGE"
}
