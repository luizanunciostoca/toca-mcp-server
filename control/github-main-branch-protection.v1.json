{
  "schemaVersion": "1.0.0",
  "policyId": "TOCA_GITHUB_MAIN_BRANCH_PROTECTION_V1",
  "repository": "luizanunciostoca/toca-mcp-server",
  "branch": "main",
  "status": "ACTIVE_CANONICAL",
  "protection": {
    "required_status_checks": {
      "strict": true,
      "contexts": [
        "Quality Gate / quality",
        "Security Supply Chain / dependency-review",
        "Security Supply Chain / vulnerability-secret-container-sbom",
        "Security Supply Chain / codeql",
        "Autonomy Safety / autonomy-safety"
      ]
    },
    "enforce_admins": true,
    "required_pull_request_reviews": {
      "dismiss_stale_reviews": true,
      "require_code_owner_reviews": true,
      "required_approving_review_count": 1,
      "require_last_push_approval": true
    },
    "restrictions": null,
    "required_linear_history": true,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "block_creations": true,
    "required_conversation_resolution": true,
    "lock_branch": false,
    "allow_fork_syncing": false
  }
}
